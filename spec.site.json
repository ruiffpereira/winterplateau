{
  "openapi": "3.0.0",
  "info": {
    "title": "API Websites — Site (construtor de páginas)",
    "version": "1.0.0",
    "description": "Objecto público do construtor de páginas: o site inteiro numa língua, ou uma página, por site token."
  },
  "servers": [
    {
      "url": "http://localhost:3001/api",
      "description": "Servidor local"
    },
    {
      "url": "https://api.rufvision.com/api",
      "description": "Servidor de produção"
    }
  ],
  "components": {
    "securitySchemes": {
      "siteTokenHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "x-site-token",
        "description": "Site token do tenant (opaco, validado por hash)."
      },
      "publicBearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Site token em Authorization: Bearer <token>. Alternativa ao x-site-token."
      }
    }
  },
  "paths": {
    "/websites/site": {
      "get": {
        "summary": "O site inteiro numa língua (um pedido por língua num build)",
        "description": "Site token OBRIGATÓRIO (`x-site-token` ou `Authorization: Bearer`). Só páginas publicadas; itens escondidos, rascunhos, manifest, pastas, nomes de blocos e ids internos nunca saem (só a âncora do bloco). `locale` inválido, ausente ou não activo no tenant → língua base. Texto `I18n` cai na base; `media` → URL; ligações para rascunhos → `href: null`. `Cache-Control: no-cache` + `ETag` (com `If-None-Match` → `304`). Sem `publicRateLimit` de propósito (um build faz dezenas de pedidos); fica o limite global.\n",
        "tags": [
          "Site"
        ],
        "security": [
          {
            "siteTokenHeader": []
          },
          {
            "publicBearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "locale",
            "required": false,
            "schema": {
              "type": "string",
              "example": "en"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Objecto do site",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "revision": {
                      "type": "integer"
                    },
                    "locale": {
                      "type": "string"
                    },
                    "defaultLanguage": {
                      "type": "string"
                    },
                    "languages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "topo": {
                      "type": "object",
                      "properties": {
                        "comps": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        }
                      }
                    },
                    "rodape": {
                      "type": "object",
                      "properties": {
                        "layout": {
                          "type": "integer",
                          "enum": [
                            1,
                            2,
                            3
                          ]
                        },
                        "bg": {
                          "type": "string"
                        },
                        "comps": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        }
                      }
                    },
                    "pages": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string",
                            "example": "/en/projects"
                          },
                          "alternates": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "string"
                            }
                          },
                          "title": {
                            "type": "string"
                          },
                          "updatedAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "seo": {
                            "type": "object",
                            "properties": {
                              "title": {
                                "type": "string"
                              },
                              "description": {
                                "type": "string"
                              },
                              "image": {
                                "type": "string",
                                "nullable": true
                              },
                              "noindex": {
                                "type": "boolean"
                              },
                              "canonical": {
                                "type": "string",
                                "nullable": true
                              }
                            }
                          },
                          "breadcrumb": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "title": {
                                  "type": "string"
                                },
                                "path": {
                                  "type": "string"
                                }
                              }
                            }
                          },
                          "items": {
                            "type": "array",
                            "description": "{kind:'block', anchor, layout, bg, comps} ou {kind:'special', type, fields}",
                            "items": {
                              "type": "object"
                            }
                          }
                        }
                      }
                    },
                    "redirects": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "from": {
                            "type": "string"
                          },
                          "to": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "304": {
            "description": "Sem alterações (ETag)"
          },
          "401": {
            "description": "Site token em falta"
          },
          "403": {
            "description": "Site token inválido ou revogado"
          },
          "404": {
            "description": "Construtor de páginas desligado para o tenant"
          },
          "413": {
            "description": "A resposta excederia o tamanho máximo (24 MB de componentes resolvidos)"
          },
          "500": {
            "description": "Erro interno"
          }
        }
      }
    },
    "/websites/site/page": {
      "get": {
        "summary": "Uma página pelo endereço (para sites em runtime)",
        "description": "Site token OBRIGATÓRIO. A língua sai do prefixo do `path` (`/en/…` → en; sem prefixo → base). Resposta igual à de `/websites/site` (cabeçalho + `topo`/`rodape`) com `page` em vez de `pages` e sem `redirects`. Endereço antigo de uma página publicada → `200 {redirect}`; inexistente ou rascunho → `404`. `Cache-Control: no-cache` + `ETag`. Sem `publicRateLimit` (fica o limite global).\n",
        "tags": [
          "Site"
        ],
        "security": [
          {
            "siteTokenHeader": []
          },
          {
            "publicBearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "/en/projects"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "`{revision, locale, defaultLanguage, languages, topo, rodape, page}` ou `{redirect}`",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "page": {
                      "type": "object",
                      "description": "Mesma forma de um elemento de `pages` em /websites/site"
                    },
                    "redirect": {
                      "type": "string",
                      "example": "/en/new"
                    }
                  }
                }
              }
            }
          },
          "304": {
            "description": "Sem alterações (ETag)"
          },
          "400": {
            "description": "`path` em falta ou inválido"
          },
          "401": {
            "description": "Site token em falta"
          },
          "403": {
            "description": "Site token inválido ou revogado"
          },
          "404": {
            "description": "Construtor desligado, ou página inexistente / em rascunho"
          },
          "413": {
            "description": "A resposta excederia o tamanho máximo (24 MB de componentes resolvidos)"
          },
          "500": {
            "description": "Erro interno"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Site",
      "description": "Objecto público do construtor de páginas (o que os sites lêem)"
    }
  ]
}