{
  "openapi": "3.0.0",
  "info": {
    "title": "API Websites — Site (construtor de páginas)",
    "version": "1.0.0",
    "description": "Objecto público do construtor de páginas: o site inteiro numa língua, ou uma página, por site token."
  },
  "servers": [
    {
      "url": "http://localhost:3001/api",
      "description": "Servidor local"
    },
    {
      "url": "https://api.rufvision.com/api",
      "description": "Servidor de produção"
    }
  ],
  "components": {
    "schemas": {
      "ApiError": {
        "type": "object",
        "description": "Resposta de erro (4xx/5xx). `error` é a mensagem em português para mostrar ao utilizador; `code` é o código estável para o código decidir. 5xx nunca leva detalhe interno.",
        "properties": {
          "error": {
            "type": "string",
            "description": "Mensagem em português de Portugal",
            "example": "Marcação não encontrada"
          },
          "code": {
            "type": "string",
            "description": "Código estável em MAIÚSCULAS (NOT_FOUND, VALIDATION, TEAM_FORBIDDEN, OUT_OF_STOCK…)",
            "example": "NOT_FOUND"
          },
          "fields": {
            "type": "array",
            "description": "Só em `VALIDATION` (400): os campos inválidos (caminho + tipo de problema, sem eco de valores)",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "code"
              ]
            }
          }
        },
        "required": [
          "error",
          "code"
        ],
        "additionalProperties": true
      }
    },
    "securitySchemes": {
      "siteTokenHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "x-site-token",
        "description": "Site token do tenant (opaco, validado por hash)."
      },
      "publicBearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Site token em Authorization: Bearer <token>. Alternativa ao x-site-token."
      }
    }
  },
  "paths": {
    "/websites/site": {
      "get": {
        "summary": "O site inteiro numa língua (um pedido por língua num build)",
        "description": "Site token OBRIGATÓRIO (`x-site-token` ou `Authorization: Bearer`). Só páginas publicadas; itens escondidos, rascunhos, manifest, pastas, nomes de blocos e ids internos nunca saem (só a âncora do bloco). `locale` inválido, ausente ou não activo no tenant → língua base. Texto `I18n` cai na base; `media` → URL; ligações para rascunhos → `href: null`. `Cache-Control: no-cache` + `ETag` (com `If-None-Match` → `304`). Sem `publicRateLimit` de propósito (um build faz dezenas de pedidos); fica o limite global.\n",
        "tags": [
          "Site"
        ],
        "security": [
          {
            "siteTokenHeader": []
          },
          {
            "publicBearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "locale",
            "required": false,
            "schema": {
              "type": "string",
              "example": "en"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Objecto do site",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "revision": {
                      "type": "integer"
                    },
                    "siteName": {
                      "type": "string",
                      "nullable": true,
                      "description": "Nome do site (definido pelo dono da plataforma), igual em todas as línguas"
                    },
                    "seo": {
                      "type": "object",
                      "description": "SEO por omissão do site, sem fallback na API (o site usa-o quando a página não tem imagem)",
                      "properties": {
                        "image": {
                          "type": "string",
                          "nullable": true,
                          "description": "Imagem de partilha por omissão (URL do tenant)"
                        },
                        "imageAlt": {
                          "type": "string",
                          "nullable": true,
                          "description": "Texto alternativo na língua do pedido (cai na base); null se vazio"
                        }
                      }
                    },
                    "locale": {
                      "type": "string"
                    },
                    "defaultLanguage": {
                      "type": "string"
                    },
                    "languages": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "topo": {
                      "type": "object",
                      "properties": {
                        "comps": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        }
                      }
                    },
                    "rodape": {
                      "type": "object",
                      "properties": {
                        "layout": {
                          "type": "integer",
                          "enum": [
                            1,
                            2,
                            3
                          ]
                        },
                        "bg": {
                          "type": "string"
                        },
                        "comps": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        }
                      }
                    },
                    "pages": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string",
                            "example": "/en/projects"
                          },
                          "alternates": {
                            "type": "object",
                            "additionalProperties": {
                              "type": "string"
                            }
                          },
                          "title": {
                            "type": "string"
                          },
                          "updatedAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "seo": {
                            "type": "object",
                            "properties": {
                              "title": {
                                "type": "string"
                              },
                              "description": {
                                "type": "string"
                              },
                              "image": {
                                "type": "string",
                                "nullable": true
                              },
                              "imageAlt": {
                                "type": "string",
                                "description": "Texto alternativo da imagem de partilha na língua (cai na base); \"\" se vazio"
                              },
                              "noindex": {
                                "type": "boolean"
                              },
                              "canonical": {
                                "type": "string",
                                "nullable": true
                              }
                            }
                          },
                          "breadcrumb": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "title": {
                                  "type": "string"
                                },
                                "path": {
                                  "type": "string"
                                }
                              }
                            }
                          },
                          "items": {
                            "type": "array",
                            "description": "{kind:'block', anchor, layout, bg, comps} ou {kind:'special', type, fields}",
                            "items": {
                              "type": "object"
                            }
                          }
                        }
                      }
                    },
                    "redirects": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "from": {
                            "type": "string"
                          },
                          "to": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "304": {
            "description": "Sem alterações (ETag)"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Site token em falta"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Site token inválido ou revogado"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Construtor inactivo para o tenant do site token (sem a permissão VIEW_SITE_PAGES, ou sem linha do construtor)"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "A resposta excederia o tamanho máximo (24 MB de componentes resolvidos)"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Erro interno"
          }
        }
      }
    },
    "/websites/site/page": {
      "get": {
        "summary": "Uma página pelo endereço (para sites em runtime)",
        "description": "Site token OBRIGATÓRIO. A língua sai do prefixo do `path` (`/en/…` → en; sem prefixo → base). Resposta igual à de `/websites/site` (cabeçalho — `revision`, `siteName`, `seo` por omissão, línguas — + `topo`/`rodape`) com `page` em vez de `pages` e sem `redirects`. Endereço antigo de uma página publicada → `200 {redirect}`; inexistente ou rascunho → `404`. `Cache-Control: no-cache` + `ETag`. Sem `publicRateLimit` (fica o limite global).\n",
        "tags": [
          "Site"
        ],
        "security": [
          {
            "siteTokenHeader": []
          },
          {
            "publicBearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "/en/projects"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "`{revision, siteName, locale, defaultLanguage, languages, topo, rodape, page}` ou `{redirect}`",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "revision": {
                      "type": "integer"
                    },
                    "siteName": {
                      "type": "string",
                      "nullable": true,
                      "description": "Nome do site (definido pelo dono da plataforma), igual em todas as línguas"
                    },
                    "seo": {
                      "type": "object",
                      "description": "SEO por omissão do site (cabeçalho), sem fallback na API; o da página está em `page.seo`",
                      "properties": {
                        "image": {
                          "type": "string",
                          "nullable": true
                        },
                        "imageAlt": {
                          "type": "string",
                          "nullable": true
                        }
                      }
                    },
                    "page": {
                      "type": "object",
                      "description": "Mesma forma de um elemento de `pages` em /websites/site"
                    },
                    "redirect": {
                      "type": "string",
                      "example": "/en/new"
                    }
                  }
                }
              }
            }
          },
          "304": {
            "description": "Sem alterações (ETag)"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "`path` em falta ou inválido"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Site token em falta"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Site token inválido ou revogado"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Construtor inactivo (tenant sem a permissão VIEW_SITE_PAGES, ou sem linha), ou página inexistente / em rascunho"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "A resposta excederia o tamanho máximo (24 MB de componentes resolvidos)"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            },
            "description": "Erro interno"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Site",
      "description": "Objecto público do construtor de páginas (o que os sites lêem)"
    }
  ]
}