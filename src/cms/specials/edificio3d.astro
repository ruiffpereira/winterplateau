---
// Especial do manifest da Winterplateau: o topo INTEIRO da página inicial (era o Hero). Texto de um lado (`eyebrow`, `titulo`,
// `descricao`, `botoes`) e a ilustração 3D do outro (`lado` = onde fica o EDIFÍCIO). A cena é desenho fixo do site, nunca editável;
// as legendas são do kit, por língua. As camadas em 3D movem-se em scripts/scene.ts (seletores `.especial--edificio3d`, `.scene`).
import { inline, md, plain, safeHref } from '../text';
import { ui } from '../ui';
const { fields, ctx, index = 0 } = Astro.props;
const t = ui(ctx.site.locale);
const pid = `hdp-${index}`; // ids únicos: o especial pode aparecer mais de uma vez na página
const str = (v: unknown): string => (typeof v === 'string' ? v : '');
const lado = fields.lado === 'esquerda' ? 'esquerda' : 'direita';
const botoes: { label?: string; href?: string; estilo?: string }[] = (Array.isArray(fields.botoes) ? fields.botoes : []).slice(0, 2).filter((b) => b && str(b.label));
---
<div class="e3d" data-lado={lado}>
  <div class="e3d-l">
    {str(fields.eyebrow) && <p class="e3d-eye" set:html={inline(fields.eyebrow)} />}
    {str(fields.titulo) && <h1 class="e3d-titulo" set:html={inline(fields.titulo)} />}
    {(str(fields.titulo) && (str(fields.descricao) || botoes.length > 0)) && <div class="e3d-rule"></div>}
    {str(fields.descricao) && <div class="e3d-desc" set:html={md(fields.descricao)} />}
    {botoes.length > 0 && (
      <div class="e3d-acts">
        {botoes.map((b) => {
          const href = safeHref(b.href);
          const cls = `c-botao c-botao--${b.estilo === 'contorno' ? 'contorno' : 'cheio'}`;
          const arrow = b.estilo !== 'contorno';
          return href ? (
            <a class={cls} href={href}>{plain(b.label)}{arrow && <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4"/></svg>}</a>
          ) : (
            <span class={cls}>{plain(b.label)}</span>
          );
        })}
      </div>
    )}
  </div>
  <div class="e3d-r">
  <div class="scene" data-amp="9" aria-hidden="true">
  <div class="stage">

    <!-- BACK PLANE — blueprint grid + ground line -->
    <div class="lyr" style="--z:-58px;--d:.02s">
      <svg viewBox="0 0 580 580" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id={pid} x="0" y="0" width="22" height="22" patternUnits="userSpaceOnUse">
            <circle cx="11" cy="11" r=".55" fill="#19A3E0" opacity="0.2"/>
          </pattern>
        </defs>
        <rect width="580" height="580" fill={`url(#${pid})`}/>
        <line x1="0" y1="542" x2="420" y2="542" stroke="#19A3E0" stroke-width="0.4" stroke-dasharray="4 5" opacity="0.35"/>
      </svg>
    </div>

    <!-- MID PLANE — building body + window openings -->
    <div class="lyr" style="--z:0px;--d:.12s">
      <svg viewBox="0 0 580 580" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="30" y="80" width="360" height="460" stroke="#19A3E0" stroke-width="0.7"/>
        <rect x="64" y="100" width="116" height="148" stroke="#19A3E0" stroke-width="0.6" fill="rgba(25,163,224,.03)"/>
        <line x1="122" y1="100" x2="122" y2="248" stroke="#19A3E0" stroke-width="0.4" opacity="0.4"/>
        <line x1="64" y1="174" x2="180" y2="174" stroke="#19A3E0" stroke-width="0.4" opacity="0.4"/>
        <rect x="240" y="100" width="116" height="148" stroke="#19A3E0" stroke-width="0.6" fill="rgba(25,163,224,.03)"/>
        <line x1="298" y1="100" x2="298" y2="248" stroke="#19A3E0" stroke-width="0.4" opacity="0.4"/>
        <line x1="240" y1="174" x2="356" y2="174" stroke="#19A3E0" stroke-width="0.4" opacity="0.4"/>
        <rect x="64" y="290" width="116" height="100" stroke="#19A3E0" stroke-width="0.6" fill="rgba(25,163,224,.03)"/>
        <line x1="122" y1="290" x2="122" y2="390" stroke="#19A3E0" stroke-width="0.4" opacity="0.4"/>
        <line x1="64" y1="340" x2="180" y2="340" stroke="#19A3E0" stroke-width="0.4" opacity="0.4"/>
        <rect x="240" y="290" width="116" height="100" stroke="#19A3E0" stroke-width="0.6" fill="rgba(25,163,224,.03)"/>
        <line x1="298" y1="290" x2="298" y2="390" stroke="#19A3E0" stroke-width="0.4" opacity="0.4"/>
        <line x1="240" y1="340" x2="356" y2="340" stroke="#19A3E0" stroke-width="0.4" opacity="0.4"/>
        <rect x="64" y="430" width="116" height="90" stroke="#19A3E0" stroke-width="0.6" fill="rgba(25,163,224,.03)"/>
        <line x1="122" y1="430" x2="122" y2="520" stroke="#19A3E0" stroke-width="0.4" opacity="0.4"/>
        <line x1="64" y1="475" x2="180" y2="475" stroke="#19A3E0" stroke-width="0.4" opacity="0.4"/>
        <rect x="240" y="430" width="116" height="90" stroke="#19A3E0" stroke-width="0.6" fill="rgba(25,163,224,.03)"/>
        <line x1="298" y1="430" x2="298" y2="520" stroke="#19A3E0" stroke-width="0.4" opacity="0.4"/>
        <line x1="240" y1="475" x2="356" y2="475" stroke="#19A3E0" stroke-width="0.4" opacity="0.4"/>
      </svg>
    </div>

    <!-- FRONT PLANE — the EPS moldings that physically project from the facade -->
    <div class="lyr front" style="--z:48px;--d:.26s">
      <svg viewBox="0 0 580 580" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Cornice (3 stepped layers) -->
        <rect x="16" y="64" width="388" height="18" stroke="#19A3E0" stroke-width="0.8" fill="rgba(25,163,224,.05)"/>
        <rect x="22" y="54" width="376" height="12" stroke="#19A3E0" stroke-width="0.6" fill="rgba(25,163,224,.03)"/>
        <rect x="30" y="46" width="360" height="10" stroke="#19A3E0" stroke-width="0.5"/>
        <!-- Pilasters -->
        <rect x="30" y="80" width="22" height="460" stroke="#19A3E0" stroke-width="0.6" fill="rgba(25,163,224,.04)"/>
        <rect x="368" y="80" width="22" height="460" stroke="#19A3E0" stroke-width="0.6" fill="rgba(25,163,224,.04)"/>
        <rect x="199" y="80" width="16" height="460" stroke="#19A3E0" stroke-width="0.5" fill="rgba(25,163,224,.025)"/>
        <!-- Bands -->
        <rect x="16" y="266" width="388" height="16" stroke="#19A3E0" stroke-width="0.9" fill="rgba(25,163,224,.05)"/>
        <rect x="22" y="258" width="376" height="9" stroke="#19A3E0" stroke-width="0.5" fill="rgba(25,163,224,.025)"/>
        <rect x="16" y="406" width="388" height="16" stroke="#19A3E0" stroke-width="0.9" fill="rgba(25,163,224,.05)"/>
        <rect x="22" y="398" width="376" height="9" stroke="#19A3E0" stroke-width="0.5" fill="rgba(25,163,224,.025)"/>
        <!-- Window sills (peitoris) -->
        <rect x="58" y="248" width="128" height="11" stroke="#19A3E0" stroke-width="1" fill="rgba(25,163,224,.07)"/>
        <rect x="52" y="258" width="140" height="6" stroke="#19A3E0" stroke-width="0.5" fill="rgba(25,163,224,.03)"/>
        <rect x="234" y="248" width="128" height="11" stroke="#19A3E0" stroke-width="1" fill="rgba(25,163,224,.07)"/>
        <rect x="228" y="258" width="140" height="6" stroke="#19A3E0" stroke-width="0.5" fill="rgba(25,163,224,.03)"/>
        <rect x="58" y="390" width="128" height="9" stroke="#19A3E0" stroke-width="1" fill="rgba(25,163,224,.07)"/>
        <rect x="234" y="390" width="128" height="9" stroke="#19A3E0" stroke-width="1" fill="rgba(25,163,224,.07)"/>
        <rect x="58" y="520" width="128" height="9" stroke="#19A3E0" stroke-width="1" fill="rgba(25,163,224,.07)"/>
        <rect x="234" y="520" width="128" height="9" stroke="#19A3E0" stroke-width="1" fill="rgba(25,163,224,.07)"/>
        <!-- Callouts -->
        <line x1="404" y1="73" x2="452" y2="56" stroke="#19A3E0" stroke-width="0.5" stroke-dasharray="3 4" opacity="0.6"/>
        <line x1="452" y1="56" x2="516" y2="56" stroke="#19A3E0" stroke-width="0.5" opacity="0.6"/>
        <text x="445" y="48" font-family="'DM Sans',sans-serif" font-size="9.5" fill="#19A3E0" font-weight="500" letter-spacing="0.1em" opacity="0.78">{t.callouts[0]}</text>
        <line x1="390" y1="200" x2="452" y2="185" stroke="#19A3E0" stroke-width="0.5" stroke-dasharray="3 4" opacity="0.6"/>
        <line x1="452" y1="185" x2="516" y2="185" stroke="#19A3E0" stroke-width="0.5" opacity="0.6"/>
        <text x="445" y="177" font-family="'DM Sans',sans-serif" font-size="9.5" fill="#19A3E0" font-weight="500" letter-spacing="0.1em" opacity="0.78">{t.callouts[1]}</text>
        <line x1="380" y1="254" x2="452" y2="264" stroke="#19A3E0" stroke-width="0.5" stroke-dasharray="3 4" opacity="0.6"/>
        <line x1="452" y1="264" x2="516" y2="264" stroke="#19A3E0" stroke-width="0.5" opacity="0.6"/>
        <text x="445" y="256" font-family="'DM Sans',sans-serif" font-size="9.5" fill="#19A3E0" font-weight="500" letter-spacing="0.1em" opacity="0.78">{t.callouts[2]}</text>
        <line x1="404" y1="274" x2="452" y2="290" stroke="#19A3E0" stroke-width="0.5" stroke-dasharray="3 4" opacity="0.6"/>
        <line x1="452" y1="290" x2="516" y2="290" stroke="#19A3E0" stroke-width="0.5" opacity="0.6"/>
        <text x="445" y="282" font-family="'DM Sans',sans-serif" font-size="9.5" fill="#19A3E0" font-weight="500" letter-spacing="0.1em" opacity="0.78">{t.callouts[3]}</text>
      </svg>
    </div>

    <i class="spark" style="--sx:14%;--sy:30%;--sz:64px;--sd:0s;--sdur:6.5s"></i>
    <i class="spark" style="--sx:82%;--sy:62%;--sz:54px;--sd:1.4s;--sdur:7.2s"></i>
    <i class="spark" style="--sx:46%;--sy:84%;--sz:40px;--sd:2.6s;--sdur:6.8s"></i>
  </div>
  <div class="scan"></div>
  </div>
  </div>
</div>
