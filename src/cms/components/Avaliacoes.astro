---
import { md, plain } from '../text';
const { comp } = Astro.props;
---
<ul class={`c-avaliacoes c-avaliacoes--${comp.style}`}>
  {(comp.items ?? []).map((i: { stars?: string | number; name?: string; text?: string }) => {
    const n = Math.min(5, Math.max(1, Number(i.stars) || 5));
    return (
      <li>
        <p class="stars" role="img" aria-label={`${n}/5`}>{'★'.repeat(n)}{'☆'.repeat(5 - n)}</p>
        <div set:html={md(i.text)} />
        <p class="name"><strong>{plain(i.name)}</strong></p>
      </li>
    );
  })}
</ul>
