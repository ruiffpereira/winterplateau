---
import { FILE } from '../icons';
import { plain, safeSrc } from '../text';
const { comp } = Astro.props;
const ext = (src: string) => (/\.([a-z0-9]{1,5})(?:[?#]|$)/i.exec(src)?.[1] ?? '').toUpperCase();
---
<ul class={`c-documentos c-documentos--${comp.style}`}>
  {(comp.items ?? []).map((i: { name?: string; file?: string }) => {
    const src = safeSrc(i.file);
    return src && (
      <li>
        <a href={src} download>
          <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24">{FILE.map((d) => <path d={d} />)}</svg></span>
          <span class="nm">{plain(i.name)}{ext(src) && <span class="ext">{ext(src)}</span>}</span>
        </a>
      </li>
    );
  })}
</ul>
