---
import { inline, md, plain, safeHref } from '../text';
const { comp } = Astro.props;
---
<ul class={`c-precos c-precos--${comp.style}`}>
  {(comp.items ?? []).map((i: { name?: string; price?: string; period?: string; features?: string; highlight?: string; cta?: string; href?: string | null }) => (
    <li data-highlight={i.highlight === 'sim' ? 'sim' : 'nao'}>
      <h3 set:html={inline(i.name)} />
      <p class="price"><strong>{plain(i.price)}</strong>{i.period && <span set:html={inline(i.period)} />}</p>
      {i.features && <div set:html={md(i.features)} />}
      {i.cta && (safeHref(i.href) ? <a href={safeHref(i.href)!}>{plain(i.cta)}</a> : <span>{plain(i.cta)}</span>)}
    </li>
  ))}
</ul>
