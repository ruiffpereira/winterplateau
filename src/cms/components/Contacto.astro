---
import { CONTACT } from '../icons';
import { md, plain, safeHref } from '../text';
const { comp } = Astro.props;
const tel = comp.phone ? safeHref(`tel:${String(comp.phone).replace(/[^\d+]/g, '')}`) : null;
const mail = comp.email ? safeHref(`mailto:${String(comp.email).trim()}`) : null;
---
<div class={`c-contacto c-contacto--${comp.style}`}>
  {comp.address && <div><span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24">{CONTACT.pin.map((d) => <path d={d} />)}</svg></span><address set:html={md(comp.address)} /></div>}
  {tel && <div><span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24">{CONTACT.phone.map((d) => <path d={d} />)}</svg></span><p><a href={tel}>{plain(comp.phone)}</a></p></div>}
  {mail && <div><span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24">{CONTACT.mail.map((d) => <path d={d} />)}</svg></span><p><a href={mail}>{plain(comp.email)}</a></p></div>}
</div>
