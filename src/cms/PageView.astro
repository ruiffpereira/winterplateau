---
// Uma página do site: topo + itens + rodapé. As duas rotas ([...path] e [lang]/[...path]) só diferem no getStaticPaths.
import Base from '../layouts/Base.astro';
import Grid from './Grid.astro';
import Renderer from './Renderer.astro';
import Topo from './Topo.astro';
import { compsOf } from './seo';
import { ui } from './ui';
import type { Ctx } from './types';

export interface Props {
  ctx: Ctx;
}
const { ctx } = Astro.props;
const { rodape, topo } = ctx.site;
const t = ui(ctx.site.locale);
// WhatsApp: o primeiro telefone internacional (+…) de um contacto ou negócio da página ou do rodapé (era o marketing.js)
const phone = [...compsOf(ctx.page.items), ...rodape.comps].find((c) => (c.type === 'contacto' || c.type === 'negocio') && /^\s*\+/.test(String(c.phone ?? '')))?.phone;
const digits = String(phone ?? '').replace(/\D/g, '');
const wa = digits.length >= 8 && digits.length <= 15 ? digits : '';
---

<Base ctx={ctx}>
  <a class="skip" href="#conteudo">{t.skip}</a>
  {topo.comps.length > 0 && <Topo ctx={ctx} />}
  <main id="conteudo" data-topo={topo.comps.length > 0 ? '' : undefined} data-ruler-label={t.sections}><Renderer items={ctx.page.items} ctx={ctx} /></main>
  {rodape.comps.length > 0 && <footer class="rodape" data-layout={rodape.layout ?? 3} data-bg={rodape.bg}><Grid comps={rodape.comps} layout={rodape.layout ?? 3} ctx={ctx} /></footer>}
  {wa && (
    <a class="wa-float" href={`https://wa.me/${wa}`} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
      <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3C9.4 3 4 8.4 4 15c0 2.1.6 4.2 1.6 6L4 29l8.2-1.5c1.2.5 2.5.7 3.8.7 6.6 0 12-5.4 12-12S22.6 3 16 3zm0 21.8c-1.2 0-2.4-.2-3.5-.7l-.5-.2-4.9.9.9-4.7-.3-.5c-1-1.7-1.6-3.6-1.6-5.6C6.1 9.5 10.5 5 16 5s9.9 4.5 9.9 10-4.4 9.8-9.9 9.8zm5.4-7.3c-.3-.2-1.8-.9-2-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.2-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.6l-1-2.3c-.3-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4-.1-.2-.3-.2-.6-.4z" /></svg>
    </a>
  )}
</Base>
