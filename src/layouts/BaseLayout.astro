---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Winterplateau — Molduras EPS, Capoto (ETICS) e Perfis Metálicos · Vila Verde, Braga',
  description = 'Fabricante português de molduras decorativas em EPS — cornijas, bandas, peitoris e pilastras — sistemas de capoto (ETICS) e perfis metálicos para tetos falsos e divisórias. Reabilitação de fachadas e construção nova. Vila Verde, Braga. Peça orçamento grátis.',
} = Astro.props;
