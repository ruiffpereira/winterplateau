---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Winterplateau — Molduras EPS, Capoto (ETICS) e Perfis Metálicos · Vila Verde, Braga',
  description = 'Fabricante português de molduras decorativas em EPS — cornijas, bandas, peitoris e pilastras — sistemas de capoto (ETICS) e perfis metálicos para tetos falsos e divisórias. Reabilitação de fachadas e construção nova. Vila Verde, Braga. Peça orçamento grátis.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="pt-PT">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="keywords" content="molduras EPS, cornijas EPS, capoto, ETICS, reabilitação de fachadas, perfis metálicos, tetos falsos, peitoris, Braga, Vila Verde" />
  <title>{title}</title>
  <link rel="canonical" href="https://www.winterplateau.pt/" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Winterplateau" />
  <meta property="og:title" content="Winterplateau — Molduras EPS, Capoto e Perfis Metálicos" />
  <meta property="og:description" content="Reabilitação de fachadas e construção nova com molduras EPS, capoto (ETICS) e perfis metálicos. Fabrico nacional, certificação CE. Vila Verde, Braga." />
  <meta property="og:url" content="https://www.winterplateau.pt/" />
  <meta property="og:image" content="https://www.winterplateau.pt/assets/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="pt_PT" />
  <meta property="og:locale:alternate" content="en_GB" />
  <meta property="og:locale:alternate" content="fr_FR" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Winterplateau — Molduras EPS, Capoto e Perfis Metálicos" />
  <meta name="twitter:description" content="Reabilitação de fachadas e construção nova. Fabrico nacional, certificação CE." />
  <meta name="twitter:image" content="https://www.winterplateau.pt/assets/og-image.png" />
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Winterplateau",
    "description": "Fabricante de molduras decorativas em EPS, sistemas de capoto (ETICS) e perfis metálicos para a construção e reabilitação.",
    "url": "https://www.winterplateau.pt/",
    "image": "https://www.winterplateau.pt/assets/og-image.png",
    "telephone": "+351253193667",
    "email": "geral@winterplateau.pt",
    "foundingDate": "2016-01",
    "address": {"@type": "PostalAddress", "streetAddress": "Avenida Principal, Nº 202", "addressLocality": "Atiães, Vila Verde", "addressRegion": "Braga", "postalCode": "4730-041", "addressCountry": "PT"},
    "areaServed": ["PT", "ES", "FR"],
    "sameAs": ["https://www.linkedin.com/company/winterplateau/", "https://www.facebook.com/winterplateau/", "https://www.instagram.com/winterplateau/"]
  }
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <slot />

  <!-- Consentimento de cookies (RGPD) -->
  <div id="cookie-consent" class="cc" hidden role="dialog" aria-label="Consentimento de cookies">
    <p class="cc__txt">Utilizamos cookies essenciais e, com o seu consentimento, cookies para melhorar a experiência. Consulte a <a href="/privacidade">política de privacidade</a>.</p>
    <div class="cc__actions">
      <button type="button" data-cc="rejected" class="cc__btn cc__btn--ghost">Rejeitar</button>
      <button type="button" data-cc="accepted" class="cc__btn">Aceitar</button>
    </div>
  </div>
  <style>
    .cc { position: fixed; left: 1rem; right: 1rem; bottom: 1rem; z-index: 60; max-width: 42rem; margin: 0 auto; display: flex; flex-direction: column; gap: .75rem; padding: 1.1rem 1.25rem; background: #1a1a1a; color: #f3f3f3; border: 1px solid rgba(255,255,255,.12); border-radius: 14px; box-shadow: 0 12px 40px rgba(0,0,0,.3); font-family: 'DM Sans', system-ui, sans-serif; }
    @media (min-width: 640px) { .cc { flex-direction: row; align-items: center; } }
    .cc__txt { margin: 0; flex: 1; font-size: .9rem; line-height: 1.5; color: #d8d8d8; }
    .cc__txt a { color: #fff; text-decoration: underline; }
    .cc__actions { display: flex; gap: .5rem; flex-shrink: 0; }
    .cc__btn { padding: .55rem .9rem; border: 0; border-radius: 9px; font-size: .85rem; font-weight: 500; cursor: pointer; background: #fff; color: #1a1a1a; }
    .cc__btn--ghost { background: transparent; color: #f3f3f3; border: 1px solid rgba(255,255,255,.25); }
  </style>
  <script is:inline>
    (function () {
      var KEY = 'cookie-consent';
      try { if (localStorage.getItem(KEY)) return; } catch (e) { return; }
      var el = document.getElementById('cookie-consent');
      if (!el) return;
      el.hidden = false;
      el.addEventListener('click', function (e) {
        var t = e.target;
        if (t && t.dataset && t.dataset.cc) {
          try { localStorage.setItem(KEY, t.dataset.cc); } catch (e2) {}
          el.hidden = true;
        }
      });
    })();
  </script>
</body>
</html>
