---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Winterplateau — Molduras EPS, Capoto (ETICS) e Perfis Metálicos · Vila Verde, Braga',
  description = 'Fabricante português de molduras decorativas em EPS — cornijas, bandas, peitoris e pilastras — sistemas de capoto (ETICS) e perfis metálicos para tetos falsos e divisórias. Reabilitação de fachadas e construção nova. Vila Verde, Braga. Peça orçamento grátis.',
} = Astro.props;

// Estatísticas (Plausible auto-hospedado, cookieless) — só com env definido.
// Cookieless → não requer o banner de consentimento.
const plausibleUrl = import.meta.env.PUBLIC_PLAUSIBLE_URL;
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
const plausibleEnabled = Boolean(plausibleUrl && plausibleDomain);
---

<!DOCTYPE html>
<html lang="pt-PT">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="keywords" content="molduras EPS, cornijas EPS, capoto, ETICS, reabilitação de fachadas, perfis metálicos, tetos falsos, peitoris, Braga, Vila Verde" />
  <title>{title}</title>
  <link rel="canonical" href="https://www.winterplateau.pt/" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Winterplateau" />
  <meta property="og:title" content="Winterplateau — Molduras EPS, Capoto e Perfis Metálicos" />
  <meta property="og:description" content="Reabilitação de fachadas e construção nova com molduras EPS, capoto (ETICS) e perfis metálicos. Fabrico nacional, certificação CE. Vila Verde, Braga." />
  <meta property="og:url" content="https://www.winterplateau.pt/" />
  <meta property="og:image" content="https://www.winterplateau.pt/assets/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="pt_PT" />
  <meta property="og:locale:alternate" content="en_GB" />
  <meta property="og:locale:alternate" content="fr_FR" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Winterplateau — Molduras EPS, Capoto e Perfis Metálicos" />
  <meta name="twitter:description" content="Reabilitação de fachadas e construção nova. Fabrico nacional, certificação CE." />
  <meta name="twitter:image" content="https://www.winterplateau.pt/assets/og-image.png" />
  <script type="application/ld+json" is:inline>
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Winterplateau",
    "description": "Fabricante de molduras decorativas em EPS, sistemas de capoto (ETICS) e perfis metálicos para a construção e reabilitação.",
    "url": "https://www.winterplateau.pt/",
    "image": "https://www.winterplateau.pt/assets/og-image.png",
    "telephone": "+351253193667",
    "email": "geral@winterplateau.pt",
    "foundingDate": "2016-01",
    "address": {"@type": "PostalAddress", "streetAddress": "Avenida Principal, Nº 202", "addressLocality": "Atiães, Vila Verde", "addressRegion": "Braga", "postalCode": "4730-041", "addressCountry": "PT"},
    "areaServed": ["PT", "ES", "FR"],
    "sameAs": ["https://www.linkedin.com/company/winterplateau/", "https://www.facebook.com/winterplateau/", "https://www.instagram.com/winterplateau/"]
  }
  </script>
  {plausibleEnabled && (
    <script defer data-domain={plausibleDomain} src={`${(plausibleUrl ?? '').replace(/\/+$/, '')}/js/script.js`}></script>
  )}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <slot />

  <!-- Consentimento de cookies (RGPD) — overlay BLOQUEANTE (por cima de tudo, até decidir) -->
  <div id="cookie-consent" class="cc-overlay" hidden role="dialog" aria-modal="true" aria-label="Consentimento de cookies">
    <div class="cc-box">
      <h2 class="cc-title">Cookies</h2>
      <p class="cc-txt">Utilizamos cookies essenciais e, com o seu consentimento, cookies para melhorar a experiência. Escolha para continuar. <a href="/privacidade">Política de privacidade</a>.</p>
      <div class="cc-actions">
        <button type="button" data-cc="rejected" class="cc-btn cc-btn--ghost">Rejeitar</button>
        <button type="button" data-cc="accepted" class="cc-btn">Aceitar</button>
      </div>
    </div>
  </div>
  <style>
    .cc-overlay { position: fixed; inset: 0; z-index: 9999; display: flex; align-items: center; justify-content: center; padding: 1rem; background: rgba(0,0,0,.7); backdrop-filter: blur(4px); font-family: 'DM Sans', system-ui, sans-serif; }
    .cc-overlay[hidden] { display: none; }
    .cc-box { width: 100%; max-width: 28rem; background: #1a1a1a; color: #f3f3f3; border: 1px solid rgba(255,255,255,.1); border-radius: 16px; padding: 1.5rem; box-shadow: 0 20px 60px rgba(0,0,0,.45); }
    .cc-title { margin: 0 0 .5rem; font-size: 1.125rem; font-weight: 600; }
    .cc-txt { margin: 0; font-size: .9rem; line-height: 1.5; color: #d8d8d8; }
    .cc-txt a { color: #fff; text-decoration: underline; }
    .cc-actions { display: flex; gap: .5rem; justify-content: flex-end; margin-top: 1.25rem; }
    .cc-btn { padding: .6rem 1rem; border: 0; border-radius: 9px; font-size: .85rem; font-weight: 500; cursor: pointer; background: #fff; color: #1a1a1a; }
    .cc-btn--ghost { background: transparent; color: #f3f3f3; border: 1px solid rgba(255,255,255,.25); }
    body.cc-locked { overflow: hidden; }
  </style>
  <script is:inline>
    (function () {
      var KEY = 'cookie-consent';
      try { if (localStorage.getItem(KEY)) return; } catch (e) { return; }
      var el = document.getElementById('cookie-consent');
      if (!el) return;
      el.hidden = false;
      document.body.classList.add('cc-locked');
      el.addEventListener('click', function (e) {
        var t = e.target;
        if (t && t.dataset && t.dataset.cc) {
          try { localStorage.setItem(KEY, t.dataset.cc); } catch (e2) {}
          el.hidden = true;
          document.body.classList.remove('cc-locked');
        }
      });
    })();
  </script>
</body>
</html>
