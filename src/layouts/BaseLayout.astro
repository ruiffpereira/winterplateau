<!DOCTYPE html>
<html lang="pt-PT">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="keywords" content="molduras EPS, cornijas EPS, capoto, ETICS, reabilitação de fachadas, perfis metálicos, tetos falsos, peitoris, Braga, Vila Verde" />
  <title>{title}</title>
  <link rel="canonical" href="https://www.winterplateau.pt/" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Winterplateau" />
  <meta property="og:title" content="Winterplateau — Molduras EPS, Capoto e Perfis Metálicos" />
  <meta property="og:description" content="Reabilitação de fachadas e construção nova com molduras EPS, capoto (ETICS) e perfis metálicos. Fabrico nacional, certificação CE. Vila Verde, Braga." />
  <meta property="og:url" content="https://www.winterplateau.pt/" />
  <meta property="og:image" content="https://www.winterplateau.pt/assets/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="pt_PT" />
  <meta property="og:locale:alternate" content="en_GB" />
  <meta property="og:locale:alternate" content="fr_FR" />
