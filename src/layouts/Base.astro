---
// Layout do construtor de páginas: <head> inteiro (SEO automático, CONTRATO §9) a partir da página do objecto da API.
import '../cms/styles/kit.css';
import '../cms/styles/components.css';
import '../cms/styles/specials.css';
import UmamiScript from '../components/UmamiScript.astro';
import { absUrl, hreflangs, jsonLd, ogLocale, shareImageOf, siteNameOf, titleOf } from '../cms/seo';
import { json, plain } from '../cms/text';
import type { Ctx } from '../cms/types';

export interface Props {
  ctx: Ctx;
}
const { ctx } = Astro.props;
const { page, site } = ctx;
const origin = Astro.site ?? 'https://www.winterplateau.pt';
const title = titleOf(page, site);
const description = plain(page.seo.description);
const canonical = absUrl(page.seo.canonical ?? page.path, origin);
const share = shareImageOf(ctx, origin);
const alternates = hreflangs(ctx, origin);
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {page.seo.noindex && <meta name="robots" content="noindex, nofollow" />}
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteNameOf(site)} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale(site.locale)} />
    {site.languages.filter((l) => l !== site.locale).map((l) => <meta property="og:locale:alternate" content={ogLocale(l)} />)}
    {share && <meta property="og:image" content={share.url} />}
    {share?.alt && <meta property="og:image:alt" content={share.alt} />}
    <meta name="twitter:card" content={share ? 'summary_large_image' : 'summary'} />
    {share && <meta name="twitter:image" content={share.url} />}
    {share?.alt && <meta name="twitter:image:alt" content={share.alt} />}
    {jsonLd(ctx, origin).map((ld) => <script type="application/ld+json" set:html={json(ld)} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    <UmamiScript />
  </head>
  <body>
    <slot />
    <script>
      import '../cms/scripts/index';
    </script>
  </body>
</html>
