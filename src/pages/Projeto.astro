<!DOCTYPE html>
<html lang="pt-PT">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Obra · Winterplateau</title>
<meta name="description" content="Detalhe de obra Winterplateau — antes e depois, processo de execução e materiais aplicados.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/winter.css">
<style is:global>
.pj-wrap{max-width:var(--mw);margin:0 auto}
.pj-hero{padding:calc(62px + clamp(36px,5vw,64px)) var(--g) clamp(36px,4vw,56px);background:#fff}
.pj-crumb{display:flex;gap:9px;align-items:center;font-size:11px;color:var(--ink3);margin-bottom:clamp(24px,4vw,42px);text-transform:uppercase;letter-spacing:.07em}
.pj-crumb a{transition:color .14s}.pj-crumb a:hover{color:var(--bl)}
.pj-crumb b{color:var(--ink);font-weight:500}.pj-crumb span{opacity:.4}
.pj-head{display:grid;grid-template-columns:1fr .92fr;gap:clamp(24px,4vw,64px);align-items:end;margin-bottom:clamp(28px,3.5vw,46px)}
.pj-type{display:inline-block;font-size:10px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--bl);margin-bottom:14px}
.pj-title{font-family:var(--fd);font-weight:300;font-size:clamp(40px,6.2vw,84px);line-height:.94;color:var(--ink);letter-spacing:-.015em}
.pj-loc{font-size:12.5px;letter-spacing:.09em;text-transform:uppercase;color:var(--ink3);margin-top:16px}
.pj-lead{font-size:15px;font-weight:300;line-height:1.85;color:var(--ink2);padding-bottom:5px}
.pj-compare figcaption{display:flex;align-items:center;justify-content:center;gap:8px;margin-top:16px;font-size:12px;letter-spacing:.03em;color:var(--ink3)}
.pj-compare figcaption svg{color:var(--bl)}

.pj-statsband{background:var(--ink);padding:clamp(32px,4vw,52px) var(--g)}
.pj-stats{display:grid;grid-template-columns:repeat(3,1fr)}
.pj-stat{padding:4px 24px;border-left:1px solid rgba(255,255,255,.1)}
.pj-stat:first-child{border-left:0;padding-left:0}
.pj-stat-n{font-family:var(--fd);font-weight:300;font-size:clamp(38px,5vw,66px);line-height:1;color:#fff}
.pj-stat-n em{font-style:normal;font-size:.38em;color:var(--bl);margin-left:4px;letter-spacing:.02em}
.pj-stat-l{font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.4);margin-top:9px}

.pj-process-sec{padding:var(--sv) var(--g);background:var(--off)}
.pj-eye{font-size:10px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--bl);margin-bottom:11px}
.pj-h2{font-family:var(--fd);font-weight:300;font-size:clamp(30px,4vw,54px);color:var(--ink);line-height:1}
.pj-sec-hdr{margin-bottom:clamp(34px,4vw,56px)}
.pj-spine{position:relative;display:grid;gap:clamp(30px,4vw,56px)}
.pj-spine::before{content:'';position:absolute;left:50%;top:-26px;bottom:-26px;width:1px;background:linear-gradient(180deg,transparent,rgba(25,163,224,.5) 5%,rgba(25,163,224,.5) 95%,transparent)}
.pj-step{display:grid;grid-template-columns:1fr clamp(70px,9vw,120px) 1fr;align-items:center;position:relative}
.pj-step-txt{grid-column:1;grid-row:1;text-align:right;justify-self:end;max-width:430px}
.pj-step-photo{grid-column:3;grid-row:1;width:100%;max-width:430px;justify-self:start}
.pj-step.flip .pj-step-txt{grid-column:3;text-align:left;justify-self:start}
.pj-step.flip .pj-step-photo{grid-column:1;justify-self:end}
.pj-node{grid-column:2;grid-row:1;justify-self:center;width:60px;height:60px;border-radius:50%;background:#fff;border:1px solid var(--bl);box-shadow:0 0 0 8px var(--off);display:grid;place-items:center;font-family:var(--fd);font-size:23px;color:var(--bl);position:relative;z-index:2}
.pj-step:not(.flip) .pj-step-txt p{margin-left:auto}
.pj-step-txt h3{font-family:var(--fd);font-weight:400;font-size:clamp(22px,2.4vw,31px);color:var(--ink);margin:0 0 9px}
.pj-step-txt p{font-size:14px;font-weight:300;line-height:1.82;color:var(--ink2);max-width:390px}

.pslot{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:11px;border:1px dashed #cbc8c1;border-radius:9px;background:#fff;color:var(--ink3);background-image:radial-gradient(circle,rgba(25,163,224,.1) .6px,transparent .6px);background-size:18px 18px}
.pslot span{font-size:10.5px;letter-spacing:.08em;text-transform:uppercase}
.pslot svg{color:var(--bl);opacity:.45}

.pj-mat-sec{padding:var(--sv) var(--g);background:#fff;border-top:1px solid var(--bdr)}
.pj-mat-in{display:grid;grid-template-columns:.82fr 1fr;gap:clamp(28px,4vw,72px);align-items:center}
.pj-mats{display:flex;flex-direction:column}
.mat{display:flex;align-items:center;gap:14px;padding:18px 4px;border-bottom:1px solid var(--bdr);font-size:clamp(17px,1.9vw,23px);font-family:var(--fd);color:var(--ink);transition:color .15s,padding .15s}
.mat:hover{color:var(--bl);padding-left:10px}
.mat svg{margin-left:auto;opacity:0;transition:opacity .15s}
.mat:hover svg{opacity:1}
.mat-dot{width:7px;height:7px;border-radius:50%;background:var(--bl);flex-shrink:0}

.pj-next{background:#0a0a0a;padding:var(--sv) var(--g)}
.pj-next-hdr{max-width:var(--mw);margin:0 auto clamp(26px,3vw,40px);display:flex;align-items:flex-end;justify-content:space-between;gap:20px}
.pj-next .osee{font-size:11px;font-weight:500;letter-spacing:.1em;text-transform:uppercase;display:inline-flex;align-items:center;gap:8px;transition:gap .15s}
.pj-next .osee:hover{gap:13px}

@media(max-width:860px){
  .pj-head{grid-template-columns:1fr;gap:18px}
  .pj-mat-in{grid-template-columns:1fr;gap:28px}
  .pj-spine::before{left:21px}
  .pj-step{grid-template-columns:1fr;padding-left:60px;gap:0}
  .pj-step-txt,.pj-step.flip .pj-step-txt{grid-column:1;grid-row:auto;text-align:left;justify-self:start}
  .pj-step-txt p{margin-left:0!important}
  .pj-step-photo,.pj-step.flip .pj-step-photo{grid-column:1;grid-row:auto;justify-self:start;margin-top:16px}
  .pj-node{position:absolute;left:21px;top:0;transform:translateX(-50%);width:44px;height:44px;font-size:17px;box-shadow:0 0 0 5px var(--off)}
  .pj-stats{grid-template-columns:1fr}
  .pj-stat{border-left:0;border-top:1px solid rgba(255,255,255,.1);padding:18px 0}
  .pj-stat:first-child{border-top:0}
}
</style>
</head>
<body>

<div id="chrome"></div>
<main id="detail"></main>
<div id="footerSlot"></div>

<script is:inline src="/assets/projects.js"></script>
<script is:inline>
document.getElementById('chrome').innerHTML = navHTML('obras');
document.getElementById('footerSlot').innerHTML = footerHTML();

const params = new URLSearchParams(location.search);
const p = getProject(params.get('obra'));
document.title = p.title + ' · ' + p.location + ' · Winterplateau';
document.getElementById('detail').innerHTML = projectDetailHTML(p);

initChrome();
initComparisons();
</script>
</body>
</html>
