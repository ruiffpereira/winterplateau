---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Universe from '../components/Universe.astro';
import Hero from '../components/Hero.astro';
import Marquee from '../components/Marquee.astro';
import Stats from '../components/Stats.astro';
import ProductEpsExterior from '../components/ProductEpsExterior.astro';
import ProductEpsInterior from '../components/ProductEpsInterior.astro';
import Statement from '../components/Statement.astro';
import MetalProfiles from '../components/MetalProfiles.astro';
import Obras from '../components/Obras.astro';
import About from '../components/About.astro';
import Testemunhos from '../components/Testemunhos.astro';
import Downloads from '../components/Downloads.astro';
import CtaBand from '../components/CtaBand.astro';
import Orcamento from '../components/Orcamento.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

import '../styles/global.css';
---

<BaseLayout>
  <Universe />
  <Nav />
  <Hero />
  <Marquee />
  <Stats />
  <ProductEpsExterior />
  <ProductEpsInterior />
  <Statement />
  <MetalProfiles />
  <Obras />
  <About />
  <Testemunhos />
  <Downloads />
  <CtaBand />
  <Orcamento />
  <Contact />
  <Footer />
  <script is:inline src="/assets/projects.js"></script>
  <script is:inline src="/scripts/home.js"></script>
  <script is:inline src="/assets/universe.js"></script>
  <script is:inline src="/assets/i18n.js"></script>
  <script is:inline src="/assets/marketing.js"></script>
</BaseLayout>
