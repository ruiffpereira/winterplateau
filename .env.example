# URL base da API (sem trailing slash)
VITE_API_BASE_URL=http://localhost:3001/api

# Token do site winterplateau (gerado no backoffice → Site Tokens)
SITE_TOKEN=

# Chave de acesso ao swagger (se configurada na API)
SWAGGER_ACCESS_TOKEN=

# Estatísticas (Plausible auto-hospedado, cookieless). Vazio = desligado.
# PUBLIC_* → expostas ao cliente no Astro (equivalente a VITE_* no Vite).
PUBLIC_PLAUSIBLE_URL=
PUBLIC_PLAUSIBLE_DOMAIN=
