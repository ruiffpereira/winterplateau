# URL base da API (sem trailing slash)
VITE_API_BASE_URL=http://localhost:3001/api

# Token do site winterplateau (gerado no backoffice → Site Tokens). Mesmo nome dos
# outros sites; o Astro só expõe PUBLIC_* ao browser, por isso fica só no build.
VITE_SITE_TOKEN=

# Chave de acesso ao swagger (se configurada na API)
SWAGGER_ACCESS_TOKEN=

# Estatísticas (Umami): o build pede o id à API com o VITE_SITE_TOKEN acima — sem
# config extra. Basta o domínio estar definido no Backoffice → Estatísticas.

# Construtor de páginas (branch cms): build sem API, a partir de um ficheiro (ver CLAUDE.md)
# CMS_FIXTURE=fixtures/site-pt.json

# Atrás da Cloudflare (Bot Fight): header X-CI-Bypass no kubb e no pedido do site
# CF_BYPASS_TOKEN=
